(* Autonomous Tractor Fleet Coordination *)

(* Core types *)
type task_type = Planting | Harvesting | Spraying | Tillage

type weather = Sunny | Rainy | Stormy

type tractor_status = Available | Low_Fuel | Needs_Maintenance | In_Collision_Zone

type assignment_decision = Assign_Task | Refuel_First | Maintenance_Required | Abort_Weather | Abort_Collision

type task_assignment = {
  decision: assignment_decision;
  can_proceed: bool;
}

(* Dead zone - fuel/maintenance combination ambiguity *)
let in_critical_zone fuel_level maintenance_hours =
  fuel_level >= 18 && fuel_level <= 22 && maintenance_hours >= 195 && maintenance_hours <= 205

(* Weather task compatibility *)
let task_weather_compatible task_type weather =
  match task_type, weather with
  | Spraying, Rainy -> false
  | Spraying, Stormy -> false
  | _, Stormy -> false
  | _ -> true

(* collision zone overrides all other decisions *)
let check_collision_override distance_to_nearest_tractor collision_active =
  collision_active && distance_to_nearest_tractor < 50

(* need 3 out of 4 readiness conditions *)
let readiness_quorum_met fuel_level maintenance_hours has_equipment task_deadline_ok =
  let c1 = fuel_level >= 30 in
  let c2 = maintenance_hours < 180 in
  let c3 = has_equipment in
  let c4 = task_deadline_ok in

  let count =
    (if c1 then 1 else 0) +
    (if c2 then 1 else 0) +
    (if c3 then 1 else 0) +
    (if c4 then 1 else 0)
  in
  count >= 3

(* Core decision function *)
let determine_task_assignment
    task_type
    weather
    fuel_level
    maintenance_hours
    has_equipment
    task_deadline_ok
    distance_to_nearest_tractor
    collision_active =

  (* Dead zone check *)
  if in_critical_zone fuel_level maintenance_hours then
    { decision = Maintenance_Required; can_proceed = false }
  else
    (* Override: Collision zone check first *)
    let collision_risk = check_collision_override distance_to_nearest_tractor collision_active in

    if collision_risk then
      { decision = Abort_Collision; can_proceed = false }
    else
      (* Weather compatibility check *)
      let weather_ok = task_weather_compatible task_type weather in

      if not weather_ok then
        { decision = Abort_Weather; can_proceed = false }
      else
        (* Critical resource checks with precedence *)
        if fuel_level < 15 then
          { decision = Refuel_First; can_proceed = false }
        else if maintenance_hours > 200 then
          { decision = Maintenance_Required; can_proceed = false }
        else
          (* Readiness quorum check *)
          let quorum = readiness_quorum_met fuel_level maintenance_hours has_equipment task_deadline_ok in

          if quorum then
            { decision = Assign_Task; can_proceed = true }
          else
            (* Decide based on what's missing *)
            if fuel_level < 30 then
              { decision = Refuel_First; can_proceed = false }
            else if maintenance_hours >= 180 then
              { decision = Maintenance_Required; can_proceed = false }
            else
              { decision = Abort_Weather; can_proceed = false }

(* Analysis
====================
 *)

(* Assumption: reasonable input ranges *)
let assume_reasonable_inputs
    (task_type : task_type)
    (weather : weather)
    (fuel_level : int)
    (maintenance_hours : int)
    (has_equipment : bool)
    (task_deadline_ok : bool)
    (distance_to_nearest_tractor : int)
    (collision_active : bool) : bool =
  fuel_level >= 10 && fuel_level <= 100 &&
  maintenance_hours >= 0 && maintenance_hours <= 250 &&
  distance_to_nearest_tractor >= 0 && distance_to_nearest_tractor <= 100

(* Q1: Enumerate all task assignment scenarios *)
let assignment_scenarios = determine_task_assignment
[@@decomp top ~prune:true ~assuming:[%id assume_reasonable_inputs] ()]

(* Q2: Can Spraying be assigned in Rainy weather with full fuel? *)
let spraying_in_rain task_type weather fuel_level maintenance_hours has_equipment task_deadline_ok distance_to_nearest_tractor collision_active =
  let assignment = determine_task_assignment task_type weather fuel_level maintenance_hours has_equipment task_deadline_ok distance_to_nearest_tractor collision_active in
  task_type = Spraying && weather = Rainy && assignment.can_proceed
[@@decomp top ~assuming:[%id assume_reasonable_inputs] ()]

(* Q3: Safety property - Collision zone should always prevent assignment *)
verify (fun task_type weather fuel_level maintenance_hours has_equipment task_deadline_ok distance_to_nearest_tractor collision_active ->
  let assignment = determine_task_assignment task_type weather fuel_level maintenance_hours has_equipment task_deadline_ok distance_to_nearest_tractor collision_active in

  (assume_reasonable_inputs task_type weather fuel_level maintenance_hours has_equipment task_deadline_ok distance_to_nearest_tractor collision_active &&
   collision_active && distance_to_nearest_tractor < 50) ==> (assignment.decision = Abort_Collision)
)
