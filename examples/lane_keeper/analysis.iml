[@@@import "model.iml"]
open Model

(* Analysis
====================
 *)

(* Restrict input space for decomposition *)
let assume_valid_inputs
    (camera_status : sensor_status)
    (lidar_status : sensor_status)
    (weather : weather)
    (time_of_day : int)
    (obstacle_distance : int)
    (speed : int)
    (lane_offset : int)
    (driver_intervention_time : int) : bool =
  (* Focused ranges for tractable decomposition *)
  (time_of_day = 12 || time_of_day = 20) &&
  obstacle_distance >= 20 && obstacle_distance <= 60 &&
  speed >= 20 && speed <= 50 &&
  lane_offset >= 15 && lane_offset <= 40 &&
  driver_intervention_time >= 10 && driver_intervention_time <= 20

(* Q1: Enumerate all distinct lane keeping control scenarios *)
let lane_keeping_scenarios camera_status lidar_status weather time_of_day obstacle_distance speed lane_offset driver_intervention_time =
  determine_lane_keeping_control camera_status lidar_status weather time_of_day obstacle_distance speed lane_offset driver_intervention_time
[@@decomp top ~prune:true ~assuming:[%id assume_valid_inputs] ()]

(* Q2: Can ManualOverride trigger due to close obstacle? *)
let override_due_to_obstacle camera_status lidar_status weather time_of_day obstacle_distance speed lane_offset driver_intervention_time =
  let decision = determine_lane_keeping_control camera_status lidar_status weather time_of_day obstacle_distance speed lane_offset driver_intervention_time in
  obstacle_distance < 30 && decision.control_mode = ManualOverride
[@@decomp top ~assuming:[%id assume_valid_inputs] ()]

(* Q3: Safety property - Active sensors in Clear weather allow at least AssistedDriving *)
verify (fun camera_status lidar_status weather time_of_day obstacle_distance speed lane_offset driver_intervention_time ->
  let valid = assume_valid_inputs camera_status lidar_status weather time_of_day obstacle_distance speed lane_offset driver_intervention_time in
  let decision = determine_lane_keeping_control camera_status lidar_status weather time_of_day obstacle_distance speed lane_offset driver_intervention_time in
  valid ==>
    ((weather = Clear && camera_status = Active && lidar_status = Active &&
      obstacle_distance > 40 && lane_offset < 25 && driver_intervention_time <= 15)
     ==> (decision.control_mode = FullAutonomous || decision.control_mode = AssistedDriving))
)
